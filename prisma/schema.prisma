// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        @default("JOB_SEEKER") // JOB_SEEKER, ADMIN, PREMIUM
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  profile         UserProfile?
  userSkills      UserSkill[]
  resumes         Resume[]
  jobs            Job[]
  applications    Application[]
  reminders       Reminder[]
  interviews      Interview[]
  conversations   AIConversation[]
  aiAnalyses      AIAnalysis[]
  llmConfig       LLMConfig?
}

model UserProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?
  location         String?
  linkedinUrl      String?
  portfolioUrl     String?
  githubUrl        String?
  currentTitle     String?
  yearsExperience  Float?   @default(0)
  currentCompany   String?
  summary          String?
  expectedSalary   String?
  noticePeriod     String?
  preferredTitles  String?  // JSON string array or comma separated
  preferredLocations String?
  remotePreference String?  // Remote, Hybrid, Onsite, Any
  employmentType   String?  // Full-time, Contract, Part-time
  expectedSalaryMin Float?
  expectedSalaryMax Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  category   String      @default("Technical") // Automation, Programming, Framework, Database, Cloud, General
  userSkills UserSkill[]
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, skillId])
}

model Resume {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename        String
  originalName    String
  fileType        String             // pdf, docx, txt
  fileUrl         String
  fileSize        Int?               @default(0)
  isPrimary       Boolean            @default(false)
  parsedText      String?
  extractedSkills String?            // JSON string array
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  applications    Application[]
  jobMatchAnalyses JobMatchAnalysis[]
}

model Job {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  companyWebsite  String?
  jobTitle        String
  description     String
  jobUrl          String?
  location        String?
  salaryMin       Float?
  salaryMax       Float?
  currency        String?            @default("USD")
  employmentType  String?            @default("Full-time")
  workMode        String?            @default("Remote") // Remote, Hybrid, Onsite
  source          String?            @default("LinkedIn") // LinkedIn, Indeed, Naukri, Company Website, Referral, Recruiter, Other
  dateFound       DateTime           @default(now())
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  applications    Application[]
  jobMatchAnalyses JobMatchAnalysis[]
}

model Application {
  id               String                @id @default(uuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId            String
  job              Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId         String?
  resume           Resume?               @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status           String                @default("Saved") // Saved, Interested, Applied, Recruiter Contacted, Screening, Technical Interview, Managerial Interview, HR Interview, Offer, Accepted, Rejected, Withdrawn
  followUpStatus   String?               @default("No") // Yes, No, Pending
  appliedDate      DateTime?
  recruiterName    String?
  recruiterEmail   String?
  referralDetails  String?
  salaryOffered    Float?
  notes            String?
  isArchived       Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  activities       ApplicationActivity[]
  appNotes         ApplicationNote[]
  interviews       Interview[]
  reminders        Reminder[]
  jobMatches       JobMatchAnalysis[]
}

model ApplicationActivity {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  eventType     String      // Job Saved, Resume Analyzed, Application Submitted, Recruiter Contacted, Interview Scheduled, Status Changed, Note Added
  description   String
  createdAt     DateTime    @default(now())
}

model ApplicationNote {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  content       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Interview {
  id              String      @id @default(uuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String      // Recruiter Screen, Technical Interview, Coding Interview, System Design, Managerial Interview, HR Interview, Final Interview
  round           Int         @default(1)
  date            DateTime
  time            String?
  timezone        String?     @default("UTC")
  interviewerName String?
  meetingLink     String?
  notes           String?
  status          String      @default("Scheduled") // Scheduled, Completed, Cancelled, Rescheduled
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Reminder {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  type          String       // Follow Up, Interview, Send Thank You Email, Application Deadline, Resume Update, Custom
  title         String
  description   String?
  dueDate       DateTime
  isCompleted   Boolean      @default(false)
  snoozedUntil  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model JobMatchAnalysis {
  id              String      @id @default(uuid())
  applicationId   String?
  application     Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeId        String?
  resume          Resume?     @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  overallScore    Float
  skillMatchScore Float
  expMatchScore   Float
  semanticScore   Float
  locationScore   Float
  keywordScore    Float
  explanation     String
  matchingSkills  String      // JSON string array
  missingSkills   String      // JSON string array
  createdAt       DateTime    @default(now())
}

model AIAnalysis {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // job_analysis, resume_analysis, resume_improvement, gap_analysis, interview_prep
  inputSummary String?
  outputJson   String
  createdAt    DateTime @default(now())
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // user, assistant, system
  content        String
  createdAt      DateTime       @default(now())
}

model LLMConfig {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   @default("openai") // openai, custom, mock
  apiKey    String?
  model     String   @default("gpt-4o")
  baseUrl   String?  @default("https://api.openai.com/v1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
